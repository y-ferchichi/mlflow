ARG MLFLOW_VERSION=2.21.3
FROM ghcr.io/mlflow/mlflow:v${MLFLOW_VERSION}

# Replace the default MLflow React UI with the Melqart optimized tracker.
#
# Why: The default UI creates one React component per metric. With 3000+ metrics
# (common in RL pretraining), this means 3000 DOM nodes, 964 MB of API responses,
# and 265+ seconds of loading time that usually crashes the browser tab.
#
# The Melqart tracker replaces the frontend only:
#   - On-demand metric fetching (only when user clicks a metric)
#   - LTTB downsampling (12K points → 1,500 per chart)
#   - Lazy chart rendering via IntersectionObserver
#   - Result: 0.03s load time, 2.2 MB payload, no crashes
#
# The MLflow server, REST API, database schema, and artifact storage
# are completely unchanged.
COPY melqart/mlflow_neptune_ui.html /usr/local/lib/python3.10/site-packages/mlflow/server/js/build/index.html
