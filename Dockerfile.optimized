ARG MLFLOW_VERSION=2.21.3
FROM ghcr.io/mlflow/mlflow:v${MLFLOW_VERSION}

# Replace the default MLflow React UI with an optimized lightweight frontend.
#
# Why: The default UI creates one React chart component per metric.
# With 3000+ metrics (common in RL pretraining), this means:
#   - 3000 DOM nodes instantiated
#   - 964 MB of API responses fetched
#   - 265+ seconds loading time, usually crashes the browser tab
#
# The optimized UI:
#   - Fetches metric history on-demand (only when user clicks a metric)
#   - LTTB downsampling (12K points -> 1,500 per chart)
#   - Lazy chart rendering via IntersectionObserver
#   - Result: 0.03s load time, 2.2 MB payload, no crashes
#
# The MLflow server, REST API, database schema, and artifact storage
# are completely unchanged.
COPY optimized_ui.html /usr/local/lib/python3.10/site-packages/mlflow/server/js/build/index.html
